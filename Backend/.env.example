NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (MANDATORY — fails fast if missing)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=RailNexus

# JWT Authentication
JWT_SECRET=<your-256-bit-hex-secret>
JWT_EXPIRES_IN=15m

# Refresh Token Authentication (Long-Lived & Rotated)
REFRESH_TOKEN_SECRET=<your-256-bit-hex-secret>
REFRESH_TOKEN_EXPIRY=10d

# Python Brain Microservice
BRAIN_SERVICE_URL=http://localhost:8000
BRAIN_TIMEOUT_MS=30000

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
